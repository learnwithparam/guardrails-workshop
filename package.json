{
  "name": "guardrails-workshop",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun scripts/readable.ts && bun scripts/plain-english.ts && bun scripts/check.ts && bun scripts/verify.ts --all && bun scripts/text-audit.ts",
    "readable": "bun scripts/readable.ts",
    "format": "biome check --write .",
    "verify": "bun scripts/verify.ts",
    "plain-english": "bun scripts/plain-english.ts",
    "shots": "bun images/shots.ts",
    "text-audit": "bun scripts/text-audit.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "playwright": "1.65.0",
    "@playwright/test": "1.65.0"
  }
}
