# Copy this file to .env and fill in only what you use. .env is git-ignored. Never commit a key.
# replay needs nothing: it is the default, and every check runs on it.
LLM_PROVIDER=replay

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# For a local model with LLM_PROVIDER=ollama
OLLAMA_MODEL=
OLLAMA_API_BASE=

# Save every live reply to world/replay/ so a later replay run gives the same answers.
LLM_RECORD=
